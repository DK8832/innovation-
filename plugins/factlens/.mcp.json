{
  "mcpServers": {
    "factlens": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./scripts/launch_mcp.cmd"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "FACTLENS_PROJECT_ROOT",
        "FACTLENS_PYTHON",
        "PATH",
        "USERPROFILE",
        "LOCALAPPDATA"
      ],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 60
    }
  }
}
